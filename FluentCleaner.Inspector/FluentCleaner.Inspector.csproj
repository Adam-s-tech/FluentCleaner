<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FluentCleaner.Inspector</RootNamespace>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- The inspector compiles the exact parser/model sources used by the desktop apps. -->
  <ItemGroup>
    <Compile Include="..\FluentCleaner.Core\Models\CleanerEntry.cs" Link="Shared\Models\CleanerEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\FileKeyEntry.cs" Link="Shared\Models\FileKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\RegKeyEntry.cs" Link="Shared\Models\RegKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\ExcludeKeyEntry.cs" Link="Shared\Models\ExcludeKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\Winapp2Parser.cs" Link="Shared\Services\Winapp2Parser.cs" />
  </ItemGroup>

</Project>
